# Copy to .env. Every value here has a working default except the API keys.

DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian
REDIS_URL=redis://localhost:6379/0

# CORS origin for the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# --- LLM -------------------------------------------------------------------
# Absent key => agent endpoints return clearly-labelled stub output rather than
# failing, so the app runs end-to-end on a fresh clone. See api/agents/llm.py.
ANTHROPIC_API_KEY=
MERIDIAN_MODEL=claude-opus-5
MERIDIAN_MODEL_VERSION=2026-07-14
MERIDIAN_TEMPERATURE=0.2

# --- Connectors ------------------------------------------------------------
# Each is optional. A connector without credentials reports itself unconfigured
# rather than erroring at import time.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Secrets ---------------------------------------------------------------
# Encrypts connector credentials at rest. Without it the app runs but refuses
# to store credentials rather than writing them in plaintext.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MERIDIAN_SECRET_KEY=
